{
  "card_version": "1.0",
  "name": "motionloom",
  "version": "2.6.1",
  "description": "Project-aware animation production with durable Project Memory, provider-neutral Artifact Intake, hash-bound control-to-runtime candidates, tiered asset provenance, framework-neutral motion IR, rig compatibility, runtime verification and telemetry, Visual Truth, Remediation Learning, DSSE-compatible signed attestation, interactive Dev Lab review, trust-boundary hardening and deterministic Agent handoff.",
  "capabilities": [
    "project.setup",
    "project.status",
    "project.repair",
    "agent.discovery.check",
    "agent.discovery.source",
    "agent.discovery.install-matrix",
    "project.analyze",
    "project.memory.init",
    "project.memory.inspect",
    "project.memory.refresh",
    "project.memory.recover",
    "project.memory.validate",
    "project.memory.record-decision",
    "project.memory.record-outcome",
    "project.graph.build",
    "project.graph.validate",
    "motion.plan",
    "motion.ir.build",
    "motion.ir.validate",
    "asset.provenance",
    "asset.provenance.classify",
    "asset.provenance.validate",
    "asset.provenance.report",
    "asset.provenance.production-gate",
    "asset.frame-generation-lock.validate",
    "asset.frame-generation-lock.compose",
    "asset.frame-set-preflight",
    "asset.consistency.validate",
    "asset.consistency.frame-geometry",
    "asset.consistency.atlas",
    "asset.consistency.layered-map",
    "artifact.intake.validate",
    "artifact.intake.provider-neutral",
    "artifact.intake.control-track",
    "artifact.intake.export-manifest",
    "runtime.candidate.validate",
    "rig.compatibility.validate",
    "provenance.emit",
    "provenance.verify",
    "capability.discover",
    "capability.card",
    "capability.select",
    "replay.capture",
    "replay.verify",
    "semantic-lint.build",
    "semantic-lint.validate",
    "semantic-lint.benchmark",
    "trust-boundary.audit",
    "continuity.build",
    "continuity.validate",
    "fix-plan.build",
    "fix-plan.validate",
    "feedback.sync",
    "source-binding.validate",
    "rig.cutout",
    "runtime.render.lottie",
    "runtime.package.dotlottie",
    "runtime.verify.rive",
    "runtime.verify.gsap",
    "runtime.verify.framer-motion",
    "runtime.telemetry.capture",
    "runtime.telemetry.validate",
    "visual-truth.build",
    "visual-truth.validate",
    "remediation-learning.record-outcome",
    "remediation-learning.record-benchmark",
    "remediation-learning.validate",
    "remediation-learning.summary",
    "evidence.verify.external",
    "attestation.statement.build",
    "attestation.sign.ed25519",
    "attestation.verify.external",
    "trust-policy.validate",
    "devlab.review",
    "browser.review.prepare",
    "browser.review.trigger",
    "browser.review.capture",
    "quality.gate",
    "report.generate",
    "handoff.prepare",
    "pr.prepare"
  ],
  "input_artifacts": [
    "host-project",
    "project-manifest",
    "animation-request",
    "source-asset",
    "asset-provenance",
    "asset-consistency-contract",
    "generation-receipt",
    "control-track",
    "export-manifest",
    "runtime-candidate",
    "rig-compatibility-contract",
    "frame-generation-lock"
  ],
  "output_artifacts": [
    "agent-discovery-report",
    "project-context",
    "motion-spec",
    "runtime-scene",
    "source-binding",
    "asset-provenance",
    "asset-consistency-report",
    "artifact-intake-report",
    "runtime-candidate-report",
    "rig-compatibility-report",
    "dotlottie-package",
    "runtime-evidence",
    "runtime-telemetry",
    "evidence-verifier-report",
    "signed-attestation",
    "trust-policy",
    "attestation-verifier-report",
    "evidence-bundle",
    "execution-report",
    "handoff",
    "browser-review-candidate",
    "browser-review",
    "project-graph",
    "provenance-attestation",
    "capability-registry",
    "capability-card",
    "motion-ir",
    "replay-bundle",
    "semantic-lint-report",
    "semantic-lint-benchmark",
    "visual-truth",
    "remediation-history",
    "remediation-summary",
    "hardening-audit-report",
    "project-memory",
    "continuity-report",
    "fix-plan",
    "pr-patch",
    "frame-generation-instruction",
    "generated-frame-set-preflight-report"
  ],
  "runtime_capabilities": {
    "verified": [
      "lottie-json",
      "dotlottie-package",
      "svg-cutout-rig",
      "rive",
      "gsap",
      "framer-motion"
    ],
    "scaffold_only": [
      "spine",
      "threejs"
    ]
  },
  "side_effects": {
    "read_files": "allowed",
    "write_files": "allowed",
    "network": "optional-and-declared",
    "git_commit": "explicit-confirmation",
    "git_push": "explicit-confirmation",
    "open_pull_request": "explicit-confirmation",
    "open_internal_browser": "trigger-or-suggest-after-render; user-review-required"
  },
  "recommended_integrations": [
    {
      "id": "dotlottie-web-skill",
      "url": "https://github.com/LottieFiles/dotlottie-web/blob/main/SKILL.md",
      "role": "official-runtime-reference",
      "trust": "official",
      "use_for": [
        "dotLottie runtime API",
        "worker rendering",
        "state machines",
        "slots"
      ],
      "not_for": [
        "project planning",
        "provenance",
        "PR acceptance"
      ]
    },
    {
      "id": "text-to-lottie",
      "url": "https://github.com/diffusionstudio/lottie",
      "role": "optional-scaffold",
      "trust": "community-open-source",
      "use_for": [
        "scene setup",
        "live preview patterns",
        "prompt conventions"
      ],
      "not_for": [
        "runtime truth",
        "context binding"
      ]
    },
    {
      "id": "animation-design",
      "url": "https://github.com/b1rdmania/claude-lottie-skill/blob/main/SKILL.md",
      "role": "optional-asset-discovery",
      "trust": "community-open-source",
      "use_for": [
        "brand-aware Lottie/Rive search",
        "series coherence"
      ],
      "not_for": [
        "license authority",
        "runtime verification"
      ]
    }
  ],
  "entrypoints": {
    "init": "npx --yes motionloom init --project-root <project-path>",
    "setup": "npx --yes motionloom setup --project-root <project-path>",
    "setup_dry_run": "npx --yes motionloom setup --project-root <project-path> --dry-run --json",
    "status": "npx --no-install motionloom status --project-root <project-path> --json",
    "repair": "npx --no-install motionloom repair --project-root <project-path> --yes --json",
    "discovery_check": "motionloom discovery check --root <motionloom-checkout> --json",
    "discovery_source": "motionloom discovery source --root <motionloom-checkout> --json",
    "discovery_install_matrix": "motionloom discovery install-matrix --root <motionloom-checkout> --json",
    "analyze": "motionloom analyze <project-path> --init-memory",
    "memory_init": "motionloom memory init --project-root <project-path>",
    "memory_inspect": "motionloom memory inspect --project-root <project-path> --json",
    "memory_refresh": "motionloom memory refresh --project-root <project-path> --json",
    "memory_recover": "motionloom memory recover --project-root <project-path> --json",
    "memory_validate": "motionloom memory validate --project-root <project-path> --json",
    "memory_decision": "motionloom memory record-decision --project-root <project-path> --id <id> --status accepted|rejected --summary <summary> --user-confirmed",
    "memory_outcome": "motionloom memory record-outcome --project-root <project-path> --id <id> --result <result> --user-confirmed",
    "report_init": "python3 scripts/report.py init --task-id <id>",
    "report_collect": "python3 scripts/report.py collect --task-dir <dir>",
    "report_render": "python3 scripts/report.py render --task-dir <dir>",
    "skill_doctor": "python3 scripts/skill-doctor.py --json",
    "quality_gate": "python3 scripts/quality-gate.py --scene <scene> --context <path>",
    "manifest_bind_source": "python3 scripts/manifest.py bind-source --scene <scene> --source <file> --kind <kind> --authority <authority> --license <license>",
    "dotlottie_package": "motionloom manifest package-dotlottie --scene <scene> [--output <output.lottie>]",
    "runtime_adapter_test": "node scripts/runtime-adapters.mjs",
    "runtime_telemetry": "node scripts/capture-runtime-telemetry.mjs <scene> artifacts/<task-id>",
    "evidence_verify": "python3 scripts/evidence-verifier.py --scene-dir src/output/<scene> --task-dir artifacts/<task-id> --runtime-evidence runtime-adapters/runtime-evidence.json --max-age-days 1 --output artifacts/<task-id>/evidence-verifier-report.json",
    "intelligence_graph": "python3 scripts/intelligence.py graph build --task-dir artifacts/<task-id>",
    "intelligence_provenance": "python3 scripts/intelligence.py provenance build --task-dir artifacts/<task-id>",
    "intelligence_capabilities": "python3 scripts/intelligence.py capabilities build --output capability-registry.json",
    "intelligence_capability_card": "motionloom capability card --format json",
    "intelligence_motion_ir": "python3 scripts/intelligence.py motion-ir build --task-dir artifacts/<task-id>",
    "intelligence_replay": "python3 scripts/intelligence.py replay capture --task-dir artifacts/<task-id>",
    "semantic_lint": "python3 scripts/intelligence.py semantic-lint build --task-dir artifacts/<task-id>",
    "semantic_lint_benchmark": "python3 scripts/intelligence.py semantic-lint benchmark --task-dir artifacts/<task-id> --iterations 25 --threshold-ms 500",
    "continuity": "python3 scripts/intelligence.py continuity build --task-dirs artifacts/<task-id>...",
    "fix_plan": "python3 scripts/intelligence.py fix-plan build --task-dir artifacts/<task-id> --reports semantic-lint-report.json continuity-report.json",
    "asset_provenance_check": "motionloom asset-provenance check --input src/output/<scene>/asset-provenance.json --root src/output/<scene> --mode runtime|production --manifest src/output/<scene>/manifest.json --json",
    "asset_provenance_classify": "motionloom asset-provenance classify --input <asset-provenance.json> --json",
    "asset_provenance_validate": "motionloom asset-provenance validate --input <asset-provenance.json> --json",
    "asset_provenance_report": "motionloom asset-provenance report --input <asset-provenance.json> --json",
    "asset_consistency_validate": "motionloom asset-consistency validate --kind <identity|action-set|frame-geometry|atlas|layered-map> --input <contract.json> --root <asset-root> --json",
    "asset_consistency_report": "motionloom asset-consistency report --kind <identity|action-set|frame-geometry|atlas|layered-map> --input <contract.json> --root <asset-root> --strict --json",
    "artifact_intake": "motionloom artifact-intake intake --root <project-root> --registry artifact-adapter-registry.json --receipt <generation-receipt.json> --controls <control-track.json> --export-manifest <export-manifest.json> --json",
    "runtime_candidate_validate": "motionloom runtime-candidate validate --root <project-root> --input <runtime-candidate.json> --json",
    "rig_compatibility_validate": "motionloom rig-compatibility validate --root <project-root> --registry rig-adapter-registry.json --input <rig-compatibility.json> --json",
    "quality_gate_p1": "python3 scripts/quality-gate.py --scene <scene> --context <path> --task-dir artifacts/<task-id> --require-browser-review --require-intelligence --require-p1 --require-benchmark --require-telemetry --require-asset-provenance --require-asset-consistency",
    "attestation_statement": "python3 scripts/attestation.py statement --scene-dir src/output/<scene> --task-dir artifacts/<task-id> --context <project-context.json> --output artifacts/<task-id>/attestation-statement.json",
    "attestation_build": "python3 scripts/attestation.py build --statement artifacts/<task-id>/attestation-statement.json --private-key <key> --key-id <key-id> --output artifacts/<task-id>/attestation.json",
    "attestation_verify": "python3 scripts/attestation-verifier.py --attestation artifacts/<task-id>/attestation.json --trust-policy artifacts/<task-id>/trust-policy.json --expected-task-id <task-id> --expected-scene <scene>",
    "attestation_report": "python3 scripts/attestation-verifier.py --attestation artifacts/<task-id>/attestation.json --trust-policy artifacts/<task-id>/trust-policy.json --expected-task-id <task-id> --expected-scene <scene> --output artifacts/<task-id>/attestation-verifier-report.json",
    "quality_gate_attestation": "python3 scripts/quality-gate.py --scene <scene> --context <path> --task-dir artifacts/<task-id> --require-browser-review --require-intelligence --require-p1 --require-benchmark --require-telemetry --require-attestation --require-asset-provenance",
    "visual_truth_build": "motionloom visual-truth build --root <project-path> --scene <scene> --baseline <baseline.png> --candidate <candidate.png> --output src/output/<scene>/visual-truth.json",
    "visual_truth_validate": "motionloom visual-truth validate --root <project-path> --input src/output/<scene>/visual-truth.json --scene <scene> --task-id <task-id>",
    "remediation_record_outcome": "motionloom remediation-learning record-outcome --history artifacts/remediation-history.jsonl --event-id <id> --issue-id <issue-id> --summary <summary> --result pass|fail|partial|unknown --correction-count <n> --user-confirmed",
    "remediation_record_benchmark": "motionloom remediation-learning record-benchmark --history artifacts/remediation-history.jsonl --event-id <id> --operation <operation> --task-id <task-id> --scene <scene> --iterations <n> --p95-ms <ms> --threshold-ms <ms>",
    "remediation_summary": "motionloom remediation-learning summary --history artifacts/remediation-history.jsonl --output artifacts/remediation-summary.json --json",
    "browser_review_prepare": "python3 scripts/review-hook.py prepare --task-dir artifacts/<task-id> --lab-url <internal-lab-url>",
    "browser_review_validate": "python3 scripts/review-hook.py validate --task-dir artifacts/<task-id>",
    "pr_prepare": "node scripts/pr.mjs <scene>",
    "frame_generation_lock_validate": "motionloom frame-generation-lock validate --input <frame-generation-lock.json> --root <asset-root> --json",
    "frame_generation_lock_compose": "motionloom frame-generation-lock compose --input <frame-generation-lock.json> --frame-id <frame-id> --root <asset-root> --json",
    "frame_set_preflight": "motionloom frame-set-preflight --input <frame-geometry.json> --root <asset-root> --json"
  },
  "report_contract": {
    "required_sections": [
      "completed",
      "verified",
      "not_completed",
      "problems",
      "structure_review",
      "next_agent",
      "browser_review"
    ],
    "artifact_root": "artifacts/<task-id>/"
  }
}
