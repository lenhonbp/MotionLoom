{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lenhonbp/MotionLoom/blob/main/contracts/apple/review-launch-descriptor.schema.json",
  "title": "MotionLoom Apple review launch descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "candidate_id", "scene", "artifact_base", "task_base", "evidence", "review_mode"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "scene": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,63}$"},
    "artifact_base": {"type": "string", "minLength": 1},
    "task_base": {"type": "string", "minLength": 1},
    "review_mode": {"type": "string", "enum": ["read_only", "annotate"]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_evidence_sha256", "candidate_report_sha256"],
      "properties": {
        "runtime_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_report_sha256": {"$ref": "#/$defs/sha256"},
        "attestation_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
