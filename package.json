{
  "name": "motionloom",
  "version": "2.6.1",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "description": "MotionLoom: project-aware animation Skill with Agent interoperability, graph, provenance, Motion IR, runtime telemetry, Visual Truth, Remediation Learning, DSSE-compatible signed attestation, external evidence verification and Dev Lab review.",
  "author": "lenhonbp",
  "bin": {
    "motionloom": "bin/motionloom.mjs"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "SUPPORT.md",
    "SKILL.md",
    "LICENSE",
    "agent-card.json",
    "capability-registry.json",
    "bin",
    "scripts",
    "src",
    "templates",
    "assets",
    "schemas",
    "references",
    "docs",
    "examples",
    "scripts/asset-provenance.py",
    "schemas/asset-provenance.schema.json",
    "examples/agent-consumer/ai-generated-pilot-provenance.json",
    "project-context.example.json",
    "requirements.txt",
    "dev-lab/public/index.html",
    "dev-lab/public/devlab.js",
    "dev-lab/public/action-library.js",
    "dev-lab/public/runtime-bridge.js",
    "tests/runtime-harness",
    "tests/evals",
    "tests/scripts/run_tests.py",
    "tests/scripts/test_attestation.py",
    "tests/scripts/test_project_memory.py",
    ".agents",
    ".claude",
    ".codex",
    "AGENTS.md",
    "agent-surfaces.json",
    "scripts/asset-consistency.py",
    "schemas/asset-identity.schema.json",
    "schemas/action-set.schema.json",
    "schemas/frame-geometry.schema.json",
    "schemas/atlas-contract.schema.json",
    "schemas/layered-map.schema.json",
    "tests/scripts/test_asset_consistency.py",
    "scripts/artifact-intake.py",
    "schemas/generation-receipt.schema.json",
    "schemas/control-track.schema.json",
    "schemas/export-manifest.schema.json",
    "schemas/artifact-adapter-registry.schema.json",
    "schemas/action-separation-verifier-evidence.schema.json",
    "artifact-adapter-registry.json",
    "examples/agent-consumer/artifact-intake",
    "tests/scripts/test_artifact_intake.py",
    "scripts/runtime-candidate.py",
    "schemas/runtime-candidate.schema.json",
    "examples/agent-consumer/runtime-candidate",
    "tests/scripts/test_runtime_candidate.py",
    "scripts/rig-compatibility.py",
    "schemas/rig-compatibility.schema.json",
    "schemas/rig-adapter-registry.schema.json",
    "rig-adapter-registry.json",
    "examples/agent-consumer/rig-compatibility",
    "tests/scripts/test_rig_compatibility.py",
    "scripts/rive-package-gate.py",
    "schemas/rive-package-manifest.schema.json",
    "examples/agent-consumer/rive-package-gate",
    "tests/scripts/test_rive_package_gate.py",
    "scripts/build-ai-pilot.py",
    "scripts/isolate-alpha-background.py",
    "tests/scripts/test_ai_pilot_builder.py",
    "tests/scripts/test_alpha_isolation.py"
  ],
  "keywords": [
    "animation",
    "agent-skill",
    "motion-design",
    "lottie",
    "dotlottie",
    "rive",
    "gsap",
    "framer-motion",
    "runtime-evidence",
    "developer-tools",
    "project-memory",
    "motion-ir",
    "provenance",
    "attestation",
    "browser-review",
    "dev-lab",
    "visual-truth",
    "remediation-learning",
    "agent-interoperability",
    "asset-consistency",
    "sprite-atlas",
    "layered-map",
    "artifact-intake",
    "generation-receipt",
    "runtime-candidate",
    "rig-compatibility",
    "rive-package-gate",
    "provider-neutral",
    "agent-skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenhonbp/MotionLoom.git"
  },
  "homepage": "https://github.com/lenhonbp/MotionLoom#readme",
  "bugs": {
    "url": "https://github.com/lenhonbp/MotionLoom/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18",
    "python": ">=3.11"
  },
  "scripts": {
    "prepack": "node scripts/prepack-clean.mjs",
    "test": "python3 tests/scripts/run_tests.py",
    "validate": "npm run quality:attestation",
    "doctor": "node bin/motionloom.mjs doctor --json",
    "doctor:runtime": "node bin/motionloom.mjs doctor --runtime --json",
    "init": "node bin/motionloom.mjs init",
    "setup": "node bin/motionloom.mjs setup",
    "setup:dry": "node bin/motionloom.mjs setup --dry-run",
    "status": "node bin/motionloom.mjs status",
    "repair": "node bin/motionloom.mjs repair",
    "docs:check": "python3 scripts/docs-audit.py",
    "eval:projects": "python3 scripts/eval-projects.py --allow-insufficient",
    "release:verify": "python3 scripts/release-verify.py",
    "report": "node bin/motionloom.mjs report",
    "report:check": "node bin/motionloom.mjs report-contract",
    "review": "node bin/motionloom.mjs review-hook",
    "devlab": "node bin/motionloom.mjs devlab",
    "manifest": "node bin/motionloom.mjs manifest",
    "intelligence": "node bin/motionloom.mjs intelligence",
    "intelligence:registry": "node bin/motionloom.mjs intelligence capabilities build --output capability-registry.json",
    "intelligence:registry:check": "node bin/motionloom.mjs intelligence capabilities validate --path capability-registry.json",
    "intelligence:card": "node bin/motionloom.mjs capability card --format json",
    "intelligence:p1": "node bin/motionloom.mjs intelligence",
    "quality:p1": "node bin/motionloom.mjs quality-gate --require-intelligence --require-p1 --require-benchmark",
    "eval:intelligence": "node bin/motionloom.mjs eval-intelligence",
    "audit:deep": "python3 tests/scripts/deep-stress.py --iterations 5000 --seed 20260813 --report docs/audits/data/deep-stress-latest.json",
    "package:smoke": "node scripts/package-consumer-smoke.mjs",
    "memory:init": "node bin/motionloom.mjs memory init --project-root .",
    "memory:bootstrap": "node bin/motionloom.mjs analyze . --init-memory",
    "memory:recover": "node bin/motionloom.mjs memory recover --project-root .",
    "memory:validate": "node bin/motionloom.mjs memory validate --project-root . --json",
    "memory:refresh": "node bin/motionloom.mjs memory refresh --project-root . --json",
    "benchmark:semantic": "node bin/motionloom.mjs intelligence semantic-lint benchmark --task-dir artifacts/professional-review-e2e --iterations 25 --threshold-ms 500",
    "evidence:verify": "node bin/motionloom.mjs evidence-verify --scene-dir src/output/browser-review-smoke --task-dir artifacts/browser-review-smoke-task --runtime-evidence runtime-adapters/runtime-evidence.json --max-age-days 1 --output artifacts/browser-review-smoke-task/evidence-verifier-report.json",
    "attestation:build": "node bin/motionloom.mjs attestation build",
    "attestation:verify": "node bin/motionloom.mjs verify-attestation",
    "attestation:policy": "node bin/motionloom.mjs attestation validate-policy",
    "attestation:keygen": "node bin/motionloom.mjs attestation-keygen",
    "quality:telemetry": "node bin/motionloom.mjs quality-gate --scene browser-review-smoke --context artifacts/browser-review-smoke-task/project-context.json --task-dir artifacts/browser-review-smoke-task --require-browser-review --require-intelligence --require-p1 --require-benchmark --require-telemetry",
    "quality:attestation": "node bin/motionloom.mjs quality-gate --scene browser-review-smoke --context artifacts/browser-review-smoke-task/project-context.json --task-dir artifacts/browser-review-smoke-task --require-browser-review --require-intelligence --require-p1 --require-benchmark --require-telemetry --require-attestation --require-visual-truth",
    "pack:dotlottie": "node scripts/to-dotlottie.mjs",
    "runtime:test": "node scripts/runtime-adapters.mjs",
    "visual-truth:build": "node bin/motionloom.mjs visual-truth build",
    "visual-truth:check": "node bin/motionloom.mjs visual-truth validate --root . --input src/output/browser-review-smoke/visual-truth.json",
    "remediation:validate": "node bin/motionloom.mjs remediation-learning validate --history artifacts/remediation-history.jsonl --json",
    "remediation:summary": "node bin/motionloom.mjs remediation-learning summary --history artifacts/remediation-history.jsonl --output artifacts/remediation-summary.json --json",
    "discovery:check": "node bin/motionloom.mjs discovery check --root . --json",
    "discovery:show": "node bin/motionloom.mjs discovery show --root . --json",
    "install:matrix": "node bin/motionloom.mjs discovery install-matrix --root . --json",
    "asset-provenance:validate": "node bin/motionloom.mjs asset-provenance validate --input examples/agent-consumer/ai-generated-pilot-provenance.json --json",
    "asset-provenance:check": "node bin/motionloom.mjs asset-provenance check --input examples/agent-consumer/ai-generated-pilot-provenance.json --root examples/agent-consumer --mode runtime --json",
    "asset:consistency": "node bin/motionloom.mjs asset-consistency validate --kind frame-geometry --input examples/agent-consumer/asset-consistency/hero-walk-frame-geometry.json --root examples/agent-consumer/asset-consistency --json",
    "asset:audit": "node bin/motionloom.mjs asset-consistency report --kind frame-geometry --input examples/agent-consumer/asset-consistency/hero-walk-frame-geometry.json --root examples/agent-consumer/asset-consistency --json",
    "action:separation": "node bin/motionloom.mjs action-separation validate --input examples/agent-consumer/asset-consistency/action-sequence/hero-walk-action-manifest.json --root examples/agent-consumer/asset-consistency --json",
    "frame:preflight": "node bin/motionloom.mjs frame-set-preflight --input examples/agent-consumer/asset-consistency/hero-walk-frame-geometry.json --root examples/agent-consumer/asset-consistency --action-manifest examples/agent-consumer/asset-consistency/action-sequence/hero-walk-action-manifest.json --json",
    "artifact:intake": "node bin/motionloom.mjs artifact-intake intake --root . --registry artifact-adapter-registry.json --receipt examples/agent-consumer/artifact-intake/hero-motion-receipt.json --controls examples/agent-consumer/artifact-intake/hero-motion-controls.json --export-manifest examples/agent-consumer/artifact-intake/hero-motion-export.json --json",
    "runtime:candidate": "node bin/motionloom.mjs runtime-candidate validate --root . --input examples/agent-consumer/runtime-candidate/hero-walk-candidate.json --json",
    "rig:compatibility": "node bin/motionloom.mjs rig-compatibility validate --root . --registry rig-adapter-registry.json --input examples/agent-consumer/rig-compatibility/hero-walk-fixture-rig.json --json",
    "rive:gate": "node bin/motionloom.mjs rive-package-gate --help",
    "pilot:build": "node bin/motionloom.mjs pilot-build --help",
    "alpha:isolate": "node bin/motionloom.mjs alpha-isolate --help"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-web": "^0.79.0",
    "@napi-rs/canvas": "^1.0.5",
    "@rive-app/canvas": "^2.39.2",
    "fflate": "^0.8.3",
    "framer-motion": "^13.1.0",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "optionalDependencies": {
    "playwright": "^1.62.1",
    "vite": "^8.2.1"
  },
  "devDependencies": {},
  "license": "MIT"
}
