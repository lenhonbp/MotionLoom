{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animation-skill-kit.dev/schemas/handoff.schema.json",
  "title": "Animation Agent handoff",
  "type": "object",
  "required": ["handoff_version", "task_id", "from_agent", "state", "summary", "next_actions", "required_artifacts", "blockers"],
  "properties": {
    "handoff_version": {"type": "string"},
    "task_id": {"type": "string"},
    "from_agent": {"type": "string"},
    "to_agent": {"type": "string"},
    "state": {"type": "string"},
    "summary": {"type": "string"},
    "next_actions": {"type": "array", "items": {"type": "object", "required": ["action"], "properties": {"action": {"type": "string"}, "skill": {"type": "string"}, "evidence_needed": {"type": "array", "items": {"type": "string"}}}}},
    "required_artifacts": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
