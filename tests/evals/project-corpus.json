        "name": "motion-one",
        "framework": "motion"
      }
    },
    {
      "id": "gsap-external",
      "class": "external",
      "external": true,
      "local_path": "external/gsap",
      "source": "https://github.com/greensock/GSAP",
      "expected": {
        "framework": "gsap"
      }
    },
    {
      "id": "rive-external",
      "class": "external",
